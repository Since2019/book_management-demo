{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动开发服务器（热更新）",
      "type": "shell",
      "command": "${workspaceFolder}\\.runtime\\node\\corepack.cmd",
      "args": ["pnpm@11.9.0", "run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
          "COREPACK_HOME": "${workspaceFolder}\\.runtime\\corepack"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
